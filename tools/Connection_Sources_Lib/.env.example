# Copy to .env in this same directory (Connection_Sources_Lib/.env) and fill in.
# Read automatically by ssh_vault.py on every 'alm-conn ssh-key-*'/'git-*' call --
# no --project flag needed, and this is intentionally separate from any one
# project's own .env (Talan_Factory/Talan_usine_config/.env). A real process
# environment variable (e.g. $env:VAULT_TOKEN) always overrides this file.

# HashiCorp Vault (SSH key + push-passphrase storage)
VAULT_ADDR=http://127.0.0.1:8200
# Dev Vault's fixed root token (docker/docker-compose.vault.yml). Replace with a
# scoped AppRole (VAULT_AUTH_METHOD=approle, VAULT_ROLE_ID, VAULT_SECRET_ID) for a
# real, non-dev Vault -- see README.md.
VAULT_TOKEN=talan-dev-root-token
# VAULT_KV_MOUNT=secret
